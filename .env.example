# Copy to .env.local and fill in. Never commit real values.

# Portfolio
NEXT_PUBLIC_SITE_URL=https://kansliet.co
NEXT_PUBLIC_GA_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_SECRET=

# Store (see docs/store/README.md)
# The store is open by default. "false" closes it (then redeploy): 404 for
# everyone but a logged-in admin, and out of the menu and sitemap.
NEXT_PUBLIC_STORE_ENABLED=
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/kansliet
STRIPE_SECRET_KEY=sk_test_...
# Locally: output of `stripe listen --print-secret`. On Vercel: the endpoint's secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
